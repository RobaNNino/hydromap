# Copia questo file in .env e compila le chiavi.
# Non committare mai il file .env reale (è già nel .gitignore).

# Chiave Google Gemini (obbligatoria per news + chat AI)
GEMINI_API_KEY=

# Modello per chat / domande (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Modello per news con grounding Google Search.
# Default: gemini-2.5-flash (molto più economico di pro, qualità comunque buona
# perché la maggior parte del valore viene dal grounding Google Search).
GEMINI_NEWS_MODEL=gemini-2.5-flash

# Età massima delle news (giorni) — default 30
NEWS_MAX_AGE_DAYS=30

# Quanto spesso il backend rigenera le news Gemini, in secondi.
# Default 21600 = 6 ore. Le news sono CONDIVISE tra tutti gli utenti
# e persistite su disco (backend/data/news_cache.json), quindi un singolo
# refresh costa una volta sola, indipendentemente da quanti utenti accedono.
# Suggeriti: 21600 (6h) per uso normale, 43200 (12h) o 86400 (24h) per
# ridurre ulteriormente la spesa Gemini.
NEWS_TTL_SECONDS=21600

# Token segreto per forzare un refresh news fuori ciclo (?fresh=1 + header
# X-Admin-Token: <token>). Se vuoto, NESSUNO può forzare un refresh AI dal
# frontend → impossibile per utenti malevoli farti bruciare credito.
NEWS_ADMIN_TOKEN=

# CORS: per il deploy su Netlify mettere il dominio del frontend.
# Esempio: CORS_ORIGINS=https://hydromap.netlify.app
# Lasciare vuoto o "*" per sviluppo locale.
CORS_ORIGINS=*

# Porta server in locale (Render imposta automaticamente PORT)
PORT=5000
